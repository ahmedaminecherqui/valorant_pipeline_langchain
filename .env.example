# Aurora Valorant Pipeline - Environment Template
# Copy this file to .env and fill in your actual keys.
# DO NOT COMMIT YOUR REAL .env FILE!

# Google Gemini API Key (Get one at https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Valorant API Key (HenrikDev - optional, mock data used if empty)
HENRIK_API_KEY=your_henrik_api_key_here

# Player Identification
VALORANT_REGION=eu
VALORANT_PUUID=5256a0cd-97e4-5ee7-8bac-6ce03d73ba87
